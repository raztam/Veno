# Client-side (inlined into JS bundle at build time)
# Dev: use your RevenueCat Test Store public key (test_...) on both platforms — rebuild after changing.
# Release: use platform-specific keys (appl_... / goog_...) — never ship test_ keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only
SENTRY_AUTH_TOKEN=
